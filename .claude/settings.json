{
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(uvicorn:*)",
      "Bash(celery:*)",
      "Bash(python:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^(backend-agui-developer|frontend-a2ui-developer|a2a-integrator|unit-tester|protocol-reviewer)$",
        "hooks": [
          { "type": "command", "command": "./.claude/hooks/snapshot-git-state.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(backend-agui-developer|frontend-a2ui-developer|a2a-integrator|unit-tester|protocol-reviewer)$",
        "hooks": [
          { "type": "command", "command": "./.claude/hooks/require-checklist-update.sh" }
        ]
      }
    ]
  }
}
