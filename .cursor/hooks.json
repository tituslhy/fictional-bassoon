{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": ".cursor/hooks/snapshot-git-state.sh",
        "matcher": "^(backend-agui-developer|frontend-a2ui-developer|a2a-integrator|unit-tester|protocol-reviewer)$"
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/require-checklist-update.sh",
        "matcher": "^(backend-agui-developer|frontend-a2ui-developer|a2a-integrator|unit-tester|protocol-reviewer)$"
      }
    ]
  }
}
