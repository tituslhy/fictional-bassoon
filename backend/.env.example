POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_DB=...
PGBOUNCER_PORT=6432

# LLM / API keys
OPENAI_API_KEY=...
TAVILY_API_KEY=...

# Infrastructure (defaults to docker network aliases)
BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://
REDIS_URL=redis://redis:6379
DB_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgbouncer:6432/${POSTGRES_DB}

# LangSmith tracing (no local containers — traces go to smith.langchain.com)
LANGSMITH_API_KEY=...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fictional-bassoon

JWT_SECRET=...

SONAR_TOKEN=...
